# Copy this file to .env.local and fill in your real Supabase project values.
# Get these from: Supabase Dashboard > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# AIVA Work Manager's product feedback inbox (server.js POST /api/feedback).
# Feedback submitted in-app goes here with source=ssc-tutor, not to Supabase.
NEXT_PUBLIC_FEEDBACK_API_URL=https://aiva-work-manager-by4q.onrender.com

# Server-only invite codes used at signup to assign a role. Ask a project
# owner for the real values — do not invent your own or the codes won't
# match what's already been shared with the team. Leaving one blank disables
# signing up with that role.
FOUNDER_ROLE_CODE=
DEVELOPER_ROLE_CODE=
TEACHER_ROLE_CODE=
STUDENT_ROLE_CODE=

# Founder-role Work Manager login, used only by scripts/pull-approved-feedback.mjs
# to fetch approved feedback briefs + screenshots for this repo. Approval notes
# are Founder-only, so a non-Founder account will fail with 403.
WORK_MANAGER_USERNAME=
WORK_MANAGER_PASSWORD=
